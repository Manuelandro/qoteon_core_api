# local: development
# production: production
NODE_ENV=development

# local: 0.0.0.0
# production: 0.0.0.0
HOST=0.0.0.0

# local: 4000
# production: 10000
PORT=4000

# local: true
# production: true
CORE_TRUST_PROXY=true

# local: postgresql://postgres:postgres@127.0.0.1:5432/qoteon
# production: <shared-production-database-url>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/qoteon

# local: disable
# production: no-verify
DATABASE_SSL_MODE=disable

# local: leave empty when DATABASE_SSL_MODE=disable
# production: leave empty when using DATABASE_SSL_MODE=no-verify; set only if you switch to verify-ca or verify-full
DATABASE_SSL_CA_FILE=

# local: leave empty when DATABASE_SSL_MODE=disable
# production: leave empty unless your Postgres provider requires client certificate authentication
DATABASE_SSL_CERT_FILE=

# local: leave empty when DATABASE_SSL_MODE=disable
# production: leave empty unless your Postgres provider requires client certificate authentication
DATABASE_SSL_KEY_FILE=

# local: use your real Supabase project URL because Core always authenticates through Supabase
# production: https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# local: use your real Supabase anon key because Core always authenticates through Supabase
# production: your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# local: http://127.0.0.1:4001
# production: http://qoteon-prompt-library:3000
PROMPT_LIBRARY_BASE_URL=http://127.0.0.1:4001

# local: qoteon-local-library-token
# production: <LIBRARY_INTERNAL_TOKEN>
PROMPT_LIBRARY_AUTH_TOKEN=qoteon-local-library-token

# local: http://127.0.0.1:4002
# production: http://qoteon-prompt-runner-api:3000
PROMPT_RUNNER_BASE_URL=http://127.0.0.1:4002

# local: qoteon-local-runner-token
# production: <RUNNER_INTERNAL_TOKEN>
PROMPT_RUNNER_AUTH_TOKEN=qoteon-local-runner-token

# local: http://127.0.0.1:4003
# production: http://qoteon-source-intelligence-api:3000
SOURCE_INTELLIGENCE_BASE_URL=http://127.0.0.1:4003

# local: qoteon-local-source-token
# production: <SOURCE_INTELLIGENCE_INTERNAL_TOKEN>
SOURCE_INTELLIGENCE_AUTH_TOKEN=qoteon-local-source-token

# local: http://127.0.0.1:4020
# production: http://qoteon-dashboard-layer:4020
DASHBOARD_LAYER_BASE_URL=http://127.0.0.1:4020

# local: qoteon-local-dashboard-token
# production: <DASHBOARD_INTERNAL_TOKEN>
DASHBOARD_LAYER_AUTH_TOKEN=qoteon-local-dashboard-token

# local: 60000
# production: 60000
CORE_RATE_LIMIT_WINDOW_MS=60000

# local: 240
# production: 240
CORE_RATE_LIMIT_DEFAULT_MAX=240

# local: 20
# production: 20
CORE_RATE_LIMIT_PROJECT_CREATE_MAX=20

# local: 30
# production: 30
CORE_RATE_LIMIT_RUN_LAUNCH_MAX=30

# local: 30
# production: 30
CORE_RATE_LIMIT_CRAWL_TRIGGER_MAX=30

# local: 120
# production: 120
CORE_BACKPRESSURE_MAX_IN_FLIGHT=120

# local: 24
# production: 24
CORE_BACKPRESSURE_MAX_IN_FLIGHT_CRITICAL=24

# local: 86400
# production: 86400
CORE_IDEMPOTENCY_EXPLICIT_TTL_SECONDS=86400

# local: 45
# production: 45
CORE_IDEMPOTENCY_IMPLICIT_TTL_SECONDS=45

# local: false
# production: false
CORE_IDEMPOTENCY_REQUIRE_HEADER=false
